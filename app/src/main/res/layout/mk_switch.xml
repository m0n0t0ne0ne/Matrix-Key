<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 switch in the monochrome palette (androidx.preference finds it by this id). -->
<com.google.android.material.materialswitch.MaterialSwitch xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/switchWidget"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clickable="false"
    android:focusable="false"
    app:thumbTint="@color/mk_switch_thumb"
    app:trackTint="@color/mk_switch_track"
    app:trackDecorationTint="@color/mk_switch_outline" />
